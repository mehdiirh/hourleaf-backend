# Copy to .env and set both secrets before starting Compose.
# Host port for the website and API; container ports stay unchanged.
APP_PORT=8080
APP_BIND=127.0.0.1

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-long-random-password
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:${APP_PORT}
COOKIE_SECURE=false
TIME_ZONE=Asia/Tehran
